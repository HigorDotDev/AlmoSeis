# URL da API (o navegador chama a API direto, ADR-0051 item 2). Padrão: http://localhost:5080
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# URL da API vista pelo servidor da página (opcional; padrão = NEXT_PUBLIC_API_BASE_URL).
# Em produção, o endereço interno do Container App da API.
API_BASE_URL=

# Valor de `PublicPage:RendererKey` da API: enviado só pelo servidor da página no header X-Web-Renderer-Key
# (isenta a renderização do limite por IP, ADR-0045). Vazio = sem isenção. Nunca use NEXT_PUBLIC_ aqui.
WEB_RENDERER_KEY=

# Site key do Cloudflare Turnstile. Em desenvolvimento, a site key de TESTE oficial que sempre passa
# (par da chave secreta de teste configurada na API). Vazio = widget não é carregado.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Endereço público da página (canonical e Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
