{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "MinSupportedAppVersion": {
      "ANDROID": "0.0.0",
      "IOS": "0.0.0",
      "WEB": "0.0.0"
    },
    "StoreUrl": {
      "ANDROID": "",
      "IOS": ""
    }
  },
  "Cors": {
    "RestaurantAppOrigins": [],
    "PublicPageOrigins": []
  },
  "ForwardedHeaders": {
    "KnownNetworks": [],
    "KnownProxies": []
  },
  "RateLimiting": {
    "Enabled": true
  },
  "Billing": {
    "GracePeriodDays": 5,
    "SuspendedToCanceledDays": 30,
    "TrialEndingNoticeDays": 2,
    "PlanCode": "PILOT",
    "MonthlyPrice": 0,
    "Asaas": {
      "BaseUrl": "https://api.asaas.com/v3",
      "ApiKey": "",
      "WebhookToken": ""
    }
  },
  "Outbox": {
    "PollMilliseconds": 250
  },
  "Idempotency": {
    "TtlHours": 72,
    "LockTimeoutSeconds": 5
  },
  "Storage": {
    "R2": {
      "AccountId": "",
      "Bucket": "almoseis-images",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "PublicBaseUrl": "https://img.almoseis.app",
      "UploadUrlMinutes": 15
    }
  },
  "ConnectionStrings": {
    "App": "REPLACE_ME",
    "Platform": "REPLACE_ME"
  },
  "Turnstile": {
    "Enabled": true,
    "SecretKey": "",
    "TimeoutSeconds": 3
  },
  "PublicPage": {
    "IpHashSecret": "",
    "RendererKey": ""
  },
  "Maps": {
    "Provider": "None",
    "TimeoutSeconds": 3,
    "GeocodeCacheDays": 30,
    "RouteCacheDays": 30,
    "RetentionJobEnabled": true,
    "RetentionIntervalMinutes": 60,
    "Google": {
      "ApiKey": ""
    },
    "Osm": {
      "NominatimUrl": "https://nominatim.openstreetmap.org",
      "OsrmUrl": "https://router.project-osrm.org",
      "UserAgent": "AlmoSeis-DeliveryQuotes/1.0 (+https://almoseis.app)",
      "AcceptStreetLevel": false
    }
  },
  "WebOrders": {
    "AcceptanceMinutes": 10,
    "ExpiryJobEnabled": true,
    "ExpiryIntervalSeconds": 30,
    "RetentionJobEnabled": true,
    "RetentionIntervalMinutes": 60,
    "ReminderMinutes": 3
  },
  "Push": {
    "Provider": "Expo",
    "ChannelId": "web-orders",
    "Sound": "web_order.wav",
    "MaxAttempts": 3,
    "RetryDelaySeconds": 30,
    "ReceiptDelayMinutes": 15,
    "MaintenanceJobEnabled": true,
    "MaintenanceIntervalMinutes": 5,
    "RegistrationRetentionDays": 30,
    "DeliveryRetentionDays": 7,
    "Expo": {
      "AccessToken": "",
      "SendUrl": "https://exp.host/--/api/v2/push/send",
      "ReceiptsUrl": "https://exp.host/--/api/v2/push/getReceipts",
      "TimeoutSeconds": 5
    }
  }
}
