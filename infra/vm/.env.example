# =====================================================================================================================
# AlmoSeis — variáveis da VM (ADR-0060, docs/09-devops.md §9.6). MODELO SEM VALORES REAIS.
#
# Na VM: copiar para /opt/almoseis/.env, preencher e `chmod 600 /opt/almoseis/.env` (dono: usuário deploy).
# NUNCA versionar o .env preenchido. Guardar uma cópia no cofre de senhas (sem ela, o backup não restaura:
# WALG_LIBSODIUM_KEY e as chaves do bucket só existem aqui).
#
# Gerar segredos:            openssl rand -hex 32
# Gerar a chave do JWT:      openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#                            e colar entre aspas duplas (pode ser em várias linhas, ou numa linha com \n).
# Valores com espaço ou caracteres especiais: entre aspas duplas. As senhas do banco só com [A-Za-z0-9]
# (entram numa connection string): use openssl rand -hex.
#
# As tags das imagens (API_IMAGE, WEB_IMAGE, MIGRATOR_IMAGE, POSTGRES_IMAGE) NÃO ficam aqui: o deploy as grava em
# /opt/almoseis/images.env.
# =====================================================================================================================

# ---------------------------------------------------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------------------------------------------------
# homolog | production (vai para Sentry/OTel e para o nome dos alertas)
DEPLOY_ENVIRONMENT=production
# Production (produção) | Staging (homologação). Staging permite Maps/Push "Fake"; Production não.
ASPNETCORE_ENVIRONMENT=Production
Logging__LogLevel__Default=Information

# ---------------------------------------------------------------------------------------------------------------------
# Caddy / domínios
# ---------------------------------------------------------------------------------------------------------------------
# Produção: api.almoseis.app e almoseis.app. Homologação: api-homolog.almoseis.app e homolog.almoseis.app.
# O DNS (Cloudflare) aponta os dois para o IP público da VM, em modo "DNS only" (nuvem cinza) — ver infra/README.md.
API_DOMAIN=api.example.com
WEB_DOMAIN=example.com
# E-mail para avisos do Let's Encrypt (expiração de certificado).
ACME_EMAIL=ops@example.com
# Opção global extra do Caddy (vazio em produção). Primeiro teste: acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
CADDY_GLOBAL_OPTIONS=
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------------------------------------------------------------
# Rede e volumes do Docker
# ---------------------------------------------------------------------------------------------------------------------
# Sub-rede do compose; é também o único proxy confiável da API (ForwardedHeaders__KnownNetworks__0).
DOCKER_SUBNET=172.30.0.0/24
VOLUME_PREFIX=almoseis
# Volume do banco. Só muda depois de uma restauração de produção (backup/restore.sh grava aqui o volume novo).
PGDATA_VOLUME=almoseis_pgdata

# ---------------------------------------------------------------------------------------------------------------------
# Limites de memória (produção 3 OCPU/18 GB; homologação 1 OCPU/6 GB — valores de homologação no comentário)
# ---------------------------------------------------------------------------------------------------------------------
PG_MEM_LIMIT=6g
# homolog: 2g
API_MEM_LIMIT=2g
# homolog: 1g
WEB_MEM_LIMIT=768m
# homolog: 512m
CADDY_MEM_LIMIT=256m

# ---------------------------------------------------------------------------------------------------------------------
# PostgreSQL 16 (papéis de 05 §5.1, ADR-0026)
# ---------------------------------------------------------------------------------------------------------------------
# Superusuário `postgres`: só administração local (docker compose exec). A API nunca usa.
POSTGRES_SUPERUSER_PASSWORD=
# Logins da aplicação. Só [A-Za-z0-9] (openssl rand -hex 32). Trocar = editar aqui + scripts/db-roles.sh + restart da api.
ALMOSEIS_MIGRATOR_DB_PASSWORD=
ALMOSEIS_APP_DB_PASSWORD=
ALMOSEIS_PLATFORM_DB_PASSWORD=
DB_APP_POOL_SIZE=40
DB_PLATFORM_POOL_SIZE=10
# Ajuste de memória (produção / homologação)
PG_SHARED_BUFFERS=1536MB
# homolog: 512MB
PG_EFFECTIVE_CACHE_SIZE=4GB
# homolog: 1536MB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_CONNECTIONS=100
PG_MAX_WAL_SIZE=2GB
PG_SHM_SIZE=512m
# Segundos entre trocas de segmento de WAL (RPO). 60 = ~1 min.
PG_ARCHIVE_TIMEOUT=60
PG_LOG_MIN_DURATION_MS=1000
# Porta no loopback da VM para túnel SSH (ssh -L 5432:127.0.0.1:5432 deploy@vm).
PG_LOCAL_PORT=5432

# ---------------------------------------------------------------------------------------------------------------------
# WAL-G → bucket S3-compatível (Cloudflare R2), um bucket POR AMBIENTE (ADR-0060)
# Valores SEM aspas (os scripts de backup os leem do contêiner).
# ---------------------------------------------------------------------------------------------------------------------
# false só em teste local sem bucket (o WAL é descartado: sem PITR).
WALG_ENABLED=true
# s3://<bucket>/<prefixo>. Ex.: s3://almoseis-pg-backup-prod/pg16
WALG_S3_PREFIX=s3://bucket-do-ambiente/pg16
# Token de API do R2 com permissão "Object Read & Write" SÓ neste bucket.
WALG_AWS_ACCESS_KEY_ID=
WALG_AWS_SECRET_ACCESS_KEY=
# https://<account-id>.r2.cloudflarestorage.com
WALG_AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
WALG_AWS_REGION=auto
# Criptografia no cliente (o bucket só vê dados cifrados). 32 bytes em hex: openssl rand -hex 32.
# PERDER ESTA CHAVE = PERDER TODOS OS BACKUPS. Guardar no cofre de senhas, fora da VM.
WALG_LIBSODIUM_KEY=
WALG_COMPRESSION_METHOD=brotli
WALG_UPLOAD_CONCURRENCY=4
# Quantas bases diárias manter (cada uma com o WAL até a seguinte). 14 = PITR de 14 dias (ADR-0037).
WALG_RETAIN_FULL=14
# URL de heartbeat (Better Stack / Healthchecks.io) chamada depois de cada base diária bem-sucedida. Vazio = sem aviso.
BACKUP_HEARTBEAT_URL=
# URL de heartbeat chamada a cada 5 min se o archive de WAL estiver em dia (backup/check-archive.sh). Vazio = sem aviso.
ARCHIVE_HEARTBEAT_URL=
# Restauração: outro prefixo de origem (ex.: ensaiar em homologação a partir do bucket de produção). Vazio = WALG_S3_PREFIX.
RESTORE_WALG_S3_PREFIX=

# =====================================================================================================================
# API (.NET): nomes de configuração com "__" (Seção__Chave). Tabela completa em docs/09-devops.md §9.6.
# =====================================================================================================================

# --- Key Vault: desligado no piloto (ADR-0060). Vazio = configuração só por variáveis de ambiente.
KeyVault__Uri=

# --- JWT (chave privada RSA em PEM). Obrigatória: a API não sobe sem ela fora de Development.
Jwt__SigningKeyPem="-----BEGIN PRIVATE KEY-----\nCOLE_AQUI\n-----END PRIVATE KEY-----"

# --- Versão mínima do app (ADR-0035). Mudar aqui + scripts/dc.sh up -d api. Ver a ordem de deploy do EP-003 (§9.4).
App__MinSupportedAppVersion__ANDROID=0.0.0
App__MinSupportedAppVersion__IOS=0.0.0
App__MinSupportedAppVersion__WEB=0.0.0
App__StoreUrl__ANDROID=
App__StoreUrl__IOS=

# --- CORS (ADR-0053 §4): origem do app no navegador (Cloudflare Pages) e da página pública. https, sem barra final.
# Produção: https://app.almoseis.app e https://almoseis.app. Homologação: https://app-homolog.almoseis.app e https://homolog.almoseis.app
Cors__RestaurantAppOrigins__0=https://app.example.com
Cors__PublicPageOrigins__0=https://example.com

RateLimiting__Enabled=true

# --- Assinatura (Asaas, ADR-0017). Homologação: sandbox (https://api-sandbox.asaas.com/v3).
Billing__PlanCode=PILOT
Billing__MonthlyPrice=0
Billing__Asaas__BaseUrl=https://api.asaas.com/v3
Billing__Asaas__ApiKey=
Billing__Asaas__WebhookToken=

# --- Fotos de produto (Cloudflare R2, bucket de imagens do ambiente — diferente do bucket de backup).
Storage__R2__AccountId=
Storage__R2__Bucket=almoseis-images-prod
Storage__R2__AccessKeyId=
Storage__R2__SecretAccessKey=
Storage__R2__PublicBaseUrl=https://img.example.com

# --- Página pública (ADR-0045, ADR-0047, ADR-0051). Os dois segredos: openssl rand -hex 32, diferentes entre si.
Turnstile__Enabled=true
Turnstile__SecretKey=
PublicPage__IpHashSecret=
PublicPage__TrackingTokenSecret=
# Mesmo valor vai para o WEB_RENDERER_KEY da página (o compose repassa).
PublicPage__RendererKey=

# --- Taxa de entrega por distância (ADR-0048). None | Google | Osm (Fake só em homologação).
Maps__Provider=None
Maps__AddressHashSecret=
Maps__Google__ApiKey=

# --- Push (ADR-0049). Expo (Fake só em homologação).
Push__Provider=Expo
Push__Expo__AccessToken=

# --- Links enviados por e-mail e WhatsApp.
PasswordReset__LinkBaseUrl=https://example.com/redefinir-senha?token=
Invitations__LinkBaseUrl=https://example.com/convite/

# --- E-mail transacional por SMTP (ADR-0060; substitui o ACS do ADR-0040). Smtp | Acs | None | Fake (None/Fake só
# registram no log e não sobem em Production).
# Brevo: smtp-relay.brevo.com:587 com STARTTLS, usuário = login SMTP do Brevo, senha = chave SMTP.
# Amazon SES (sa-east-1): email-smtp.sa-east-1.amazonaws.com:587 com STARTTLS, credenciais SMTP do IAM.
Email__Provider=Smtp
Email__From="AlmoSeis <nao-responda@example.com>"
Email__Smtp__Host=
Email__Smtp__Port=587
# true = STARTTLS obrigatório (587). false na 465 = TLS implícito.
Email__Smtp__UseStartTls=true
Email__Smtp__Username=
Email__Smtp__Password=

# --- Telemetria opcional por OTLP (vazio = desligada; os logs ficam só no `docker logs`). Para o Sentry, usar o
# endpoint OTLP do projeto Sentry aqui. Nunca payload, telefone nem token (ADR-0024).
# Ex.: https://otlp-gateway-prod-sa-east-1.grafana.net/otlp
Otel__Endpoint=
# HttpProtobuf | Grpc
Otel__Protocol=HttpProtobuf
# Formato chave=valor,chave2=valor2. Ex.: "Authorization=Basic xxxx"
Otel__Headers=
# Fração dos traces amostrados (cabe no plano gratuito).
Otel__TraceSampleRatio=0.2
