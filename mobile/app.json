{
  "expo": {
    "name": "AlmoSeis",
    "slug": "almoseis",
    "scheme": "almoseis",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.almoseis",
      "associatedDomains": [
        "applinks:almoseis.app"
      ]
    },
    "android": {
      "package": "app.almoseis",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "almoseis.app",
              "pathPrefix": "/convite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-audio",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "O AlmoSeis usa suas fotos para a imagem dos pratos e bebidas.",
          "cameraPermission": "O AlmoSeis usa a câmera para fotografar os pratos e bebidas."
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
